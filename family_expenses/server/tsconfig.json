{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "src",
    "scripts",
    "test"
  ],
  "exclude": [
    "test/client-mocks",
    "test/client-sync.test.ts",
    "test/ledger.test.ts"
  ]
}
