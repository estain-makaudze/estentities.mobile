# Bundled Postgres (docker compose `db` service)
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://family:change-me@db:5432/family

# Or point at the Postgres already running on the ESTENTITIES host:
# DATABASE_URL=postgres://family:secret@host.docker.internal:5432/family

# Country code used for local numbers like 0771234567 (263 = Zimbabwe)
DEFAULT_COUNTRY_CODE=263

# Only for the one-time Supabase import (npm run import:supabase)
# SUPABASE_DB_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
